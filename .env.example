# Public Vite environment variables must use the VITE_ prefix.
# Keep private service keys on a server only. This frontend currently requires
# no client-exposed secrets.
VITE_CLIENT_WHATSAPP_NUMBER=923001234567
VITE_CLIENT_ORDER_EMAIL=orders@dotfumes.com
VITE_BASE_URL=https://dotfumes.com
VITE_GOOGLE_APPS_SCRIPT_WEB_APP_URL=
# Optional alias (same value as VITE_GOOGLE_APPS_SCRIPT_WEB_APP_URL)
VITE_GOOGLE_APPS_SCRIPT_URL=
VITE_ORDER_FORM_PUBLIC_TOKEN=
# Optional alias (same value as VITE_ORDER_FORM_PUBLIC_TOKEN)
VITE_PUBLIC_FORM_TOKEN=
VITE_ADMIN_PASSWORD=
VITE_ADMIN_READ_TOKEN=
