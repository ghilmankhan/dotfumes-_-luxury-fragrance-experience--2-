# Public Vite environment variables must use the VITE_ prefix.
# Keep private service keys (service_role, secrets) out of this file entirely
# — anything with a VITE_ prefix is bundled into the browser.
VITE_CLIENT_WHATSAPP_NUMBER=923001234567
VITE_CLIENT_ORDER_EMAIL=orders@dotfumes.com
VITE_BASE_URL=https://dotfumes.com

# Supabase is the only backend. Orders, products, settings, payments, and
# storage are all controlled server-side (Postgres + Edge Functions + RLS).
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) — safe for the browser. Never put the
# service_role/secret key in any VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
